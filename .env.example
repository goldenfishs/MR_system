# Docker Compose production configuration. Copy to .env and fill required values.
# Generate a URI-safe PostgreSQL password: openssl rand -hex 24
POSTGRES_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=管理员

# Keep cookies HTTPS-only. Terminate HTTPS at a reverse proxy on this host.
SESSION_SECURE=true
APP_BIND=127.0.0.1:8080

# Optional exact public origin, e.g. https://team.example.com (no trailing slash).
PUBLIC_ORIGIN=

# Email verification is required for public registration. Existing users can
# still log in when SMTP is not configured. Bulk email also requires SMTP.
# Use your provider's SMTP credentials; Compose does not deploy a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=QUT机器人战队

# Optional Judge0-compatible execution service. The base Compose deployment
# does not run it; see compose.judge0.yaml for the private local stack.
# JUDGE_URL must be reachable from the app container; localhost means that container.
# Never expose the service or its API key to browsers. User source code runs in
# the judge's sandbox, not this web app process.
JUDGE_URL=
JUDGE_TOKEN=

# For the optional compose.judge0.yaml deployment. Use independent random values
# for both tokens and for Judge0's PostgreSQL and Redis passwords in judge0.conf.
JUDGE0_AUTHN_TOKEN=
JUDGE0_AUTHZ_TOKEN=
