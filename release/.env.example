# 安装包内的镜像固定到本次发布的 digest；升级时使用新发布的值。
MR_IMAGE=@IMAGE_REFERENCE@
# 数据库密码使用 48 位十六进制字符，避免 URL 转义问题。
POSTGRES_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=管理员
APP_BIND=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8080
# HTTP 本地体验为 false；配置 HTTPS 反向代理时必须改为 true。
SESSION_SECURE=false
TRUSTED_PROXY_IPS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=MR 机器人战队
JUDGE_URL=
JUDGE_TOKEN=
